package openblrq:engine@0.1.0;

interface entities {
    use types.{entity, transform, asset, field, host-error};

    spawn: func(at: transform) -> result<entity, host-error>;
    despawn: func(e: entity) -> result<_, host-error>;

    get-transform: func(e: entity) -> result<transform, host-error>;
    set-transform: func(e: entity, to: transform) -> result<_, host-error>;

    /// Attaches a model from the release. Pass none to remove it.
    set-model: func(e: entity, model: option<asset>) -> result<_, host-error>;

    /// Sets a component declared in openblrq.toml. Fields not given keep their values.
    set-component: func(e: entity, name: string, fields: list<field>) -> result<_, host-error>;
    get-component: func(e: entity, name: string) -> result<option<list<field>>, host-error>;
    remove-component: func(e: entity, name: string) -> result<_, host-error>;

    /// Every entity that currently has the named component.
    with-component: func(name: string) -> result<list<entity>, host-error>;
}

interface players {
    use types.{player, entity, host-error};

    record player-info {
        handle: player,
        /// Stable for this experience and this account, unrelated to the account's ID or
        /// to the ID any other experience sees. Safe to use as a storage key.
        id: string,
        display-name: string,
    }

    connected: func() -> list<player-info>;

    /// The entity the client's camera follows and that receives this player's movement input.
    set-character: func(p: player, e: option<entity>) -> result<_, host-error>;

    /// Removes the player from the instance. The reason is shown to them by the client.
    kick: func(p: player, reason: string) -> result<_, host-error>;
}

/// The experience channel between this server component and its client components.
interface messaging {
    use types.{player, host-error};

    send: func(to: player, payload: list<u8>) -> result<_, host-error>;
    broadcast: func(payload: list<u8>) -> result<_, host-error>;
}

interface timers {
    use types.{host-error};

    /// Calls timer-fired with the returned id after the given number of ticks.
    schedule: func(after-ticks: u32) -> result<u64, host-error>;
    cancel: func(id: u64);
}

/// Needs the "physics" capability. The instance is 2D or 3D, as declared in the manifest;
/// in 2D the z components of vectors are ignored.
interface physics {
    use types.{entity, vec3, asset, host-error};

    enum body-kind { dynamic, fixed, kinematic }

    record capsule { half-height: f32, radius: f32 }

    variant shape {
        ball(f32),
        cuboid(vec3),
        capsule(capsule),
        /// Convex hull of a model in the release.
        hull(asset),
    }

    record material {
        friction: f32,
        restitution: f32,
        density: f32,
    }

    record ray-hit {
        entity: entity,
        distance: f32,
        point: vec3,
        normal: vec3,
    }

    add-body: func(e: entity, kind: body-kind) -> result<_, host-error>;
    remove-body: func(e: entity) -> result<_, host-error>;
    add-collider: func(e: entity, shape: shape, mat: material) -> result<_, host-error>;

    get-velocity: func(e: entity) -> result<vec3, host-error>;
    set-velocity: func(e: entity, linear: vec3) -> result<_, host-error>;
    apply-impulse: func(e: entity, impulse: vec3) -> result<_, host-error>;

    raycast: func(origin: vec3, direction: vec3, max-distance: f32) -> result<option<ray-hit>, host-error>;
}

/// Needs the "storage" capability. Data kept across instances: one store for the experience,
/// and one per player.
///
/// Reads come from this instance's copy, so they're immediate. The experience store is loaded
/// when the instance starts and picks up other instances' writes every few seconds. A player's
/// store is loaded before `player-joined` and only one instance holds it at a time. Writes apply
/// to the copy at once and are saved in the background within 5 seconds.
///
/// Keys are UTF-8, up to 256 bytes. Values are up to 64 KiB.
interface storage {
    use types.{player, host-error};

    record entry {
        value: list<u8>,
        /// Goes up by one on every write. 0 means the key doesn't exist.
        version: u64,
    }

    get: func(key: string) -> result<option<entry>, host-error>;
    /// Last write wins, across all instances.
    set: func(key: string, value: list<u8>) -> result<_, host-error>;
    delete: func(key: string) -> result<_, host-error>;
    keys: func(prefix: string) -> result<list<string>, host-error>;

    /// Adds `delta` to a counter, atomically across instances. The value is a signed 64-bit
    /// integer stored as 8 bytes little-endian; a missing key counts as 0. Returns the new value
    /// as this instance sees it, which may not yet include other instances' increments.
    increment: func(key: string, delta: s64) -> result<s64, host-error>;

    /// Writes `value` only if the stored version is still `expected-version`. Other instances may
    /// have written in the meantime, and only the store can tell, so the answer comes later:
    /// this returns a request id, and `storage-updated` is called with it once the write is saved
    /// or refused with `conflict`.
    update: func(key: string, expected-version: u64, value: list<u8>) -> result<u64, host-error>;

    player-get: func(p: player, key: string) -> result<option<entry>, host-error>;
    player-set: func(p: player, key: string, value: list<u8>) -> result<_, host-error>;
    player-delete: func(p: player, key: string) -> result<_, host-error>;
    player-keys: func(p: player, prefix: string) -> result<list<string>, host-error>;
    /// Like `update`, but a player's store is only ever held by this instance, so the answer is
    /// immediate: the new version, or `conflict`.
    player-update: func(p: player, key: string, expected-version: u64, value: list<u8>) -> result<u64, host-error>;
}

/// Functions the host calls on a server component.
interface server-events {
    use players.{player-info};
    use types.{player, host-error};

    /// Called once, before the first tick. `config` is the experience's server config from
    /// the manifest, as UTF-8 TOML.
    init: func(config: string);

    tick: func();

    /// With the "storage" capability, called once the player's store is loaded.
    player-joined: func(p: player-info);
    player-left: func(p: player);

    client-message: func(sender: player, payload: list<u8>);
    timer-fired: func(id: u64);

    /// The outcome of a `storage.update`: the new version, or `conflict` if another instance
    /// wrote first, or `limit-reached` if the store was full. Never called without storage.
    storage-updated: func(request: u64, outcome: result<u64, host-error>);

    /// Called when the instance is stopping. Storage writes made here are still saved.
    shutdown: func();
}

world server {
    import log;
    import time;
    import entities;
    import players;
    import messaging;
    import timers;
    import physics;
    import storage;

    export server-events;
}
